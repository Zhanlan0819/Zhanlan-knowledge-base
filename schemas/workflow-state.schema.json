{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/kb/workflow-state.schema.json",
  "title": "RUN_STATE.json",
  "type": "object", "required": ["schema_version", "run_id", "raw_id", "suggestion_run_id", "status", "current_stage", "stages", "checkpoints", "decisions", "created_at", "updated_at"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "0.2.0"}, "run_id": {"type": "string"}, "raw_id": {"type": "string"},
    "suggestion_run_id": {"type": "string"}, "status": {"enum": ["running", "waiting_user_approval", "completed", "completed_nonknowledge", "rejected", "failed", "needs_revision"]},
    "current_stage": {"type": ["string", "null"]},
    "stages": {"type": "object", "additionalProperties": {"type": "object", "required": ["status", "version", "artifact_id", "sha256", "error"],
      "additionalProperties": false, "properties": {"status": {"enum": ["not_started", "completed", "waiting_review", "failed", "needs_revision", "stale", "not_applicable"]},
        "version": {"type": "integer", "minimum": 0}, "artifact_id": {"type": ["string", "null"]},
        "sha256": {"type": ["string", "null"]}, "error": {"type": ["string", "null"]}}}},
    "checkpoints": {"type": "object", "additionalProperties": {"type": "object", "required": ["status", "stage", "reason", "proposal_ids"],
      "properties": {"status": {"enum": ["waiting_user_approval", "approved", "rejected"]}, "stage": {"type": "string"},
        "reason": {"type": "string"}, "proposal_ids": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false}},
    "decisions": {"type": "array", "items": {"type": "object", "required": ["id", "checkpoint", "proposal_id", "source_artifact_id", "decision", "approved_by", "approved_at", "accepted_changes", "rejected_changes", "signature"],
      "additionalProperties": false, "properties": {"id": {"type": "string"}, "checkpoint": {"type": "string"},
        "proposal_id": {"type": ["string", "null"]}, "source_artifact_id": {"type": "string"},
        "decision": {"enum": ["approved", "rejected", "partial"]},
        "approved_by": {"type": "string"}, "approved_at": {"type": "string", "format": "date-time"},
        "accepted_changes": {"type": "array", "items": {"type": "string"}},
        "rejected_changes": {"type": "array", "items": {"type": "string"}}, "signature": {"type": "string"}}}},
    "created_at": {"type": "string", "format": "date-time"}, "updated_at": {"type": "string", "format": "date-time"}
  }
}
