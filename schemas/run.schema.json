{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/kb/run.schema.json",
  "title": "本项目适配层：只增不改的运行结果",
  "type": "object", "required": ["id", "schema_version", "raw_id", "assets", "atoms", "claims", "families", "themes", "relations", "proposals", "canonical", "formal_skills"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^run_[a-f0-9]{16}$"},
    "schema_version": {"const": "0.1.0"}, "raw_id": {"type": "string", "pattern": "^raw_[a-f0-9]{16}$"},
    "automation_level": {"const": "deterministic_contract_only"},
    "assets": {"type": "array", "items": {"$ref": "#/$defs/asset"}},
    "atoms": {"type": "array", "items": {"$ref": "#/$defs/atom"}},
    "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
    "families": {"type": "array", "items": {"$ref": "#/$defs/family"}},
    "themes": {"type": "array", "items": {"$ref": "#/$defs/theme"}},
    "relations": {"type": "array", "items": {"$ref": "#/$defs/relation"}},
    "proposals": {"type": "array", "items": {"$ref": "#/$defs/proposal"}},
    "canonical": {"type": "array", "maxItems": 0}, "formal_skills": {"type": "array", "maxItems": 0}
  },
  "$defs": {
    "anchor": {"type": "object", "required": ["start", "end", "quote", "offset_unit"], "properties": {
      "start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 1},
      "quote": {"type": "string", "minLength": 1}, "offset_unit": {"const": "UTF-16"}}, "additionalProperties": false},
    "asset": {"type": "object", "required": ["id", "raw_id", "type", "anchor", "status", "parent_tag", "child_tag"],
      "properties": {"id": {"type": "string"}, "raw_id": {"type": "string"}, "type": {"enum": ["knowledge", "case", "copy", "idea", "todo", "project", "external", "unorganized"]},
        "anchor": {"$ref": "#/$defs/anchor"}, "status": {"enum": ["provisional", "unorganized"]},
        "parent_tag": {"type": ["string", "null"]}, "child_tag": {"type": ["string", "null"]}}, "additionalProperties": false},
    "atom": {"type": "object", "required": ["id", "asset_id", "raw_id", "anchor", "statement", "status"],
      "properties": {"id": {"type": "string"}, "asset_id": {"type": "string"}, "raw_id": {"type": "string"},
        "anchor": {"$ref": "#/$defs/anchor"}, "statement": {"type": "string"}, "status": {"const": "provisional"}}, "additionalProperties": false},
    "claim": {"type": "object", "required": ["id", "atom_id", "raw_id", "anchor", "statement", "source_status", "evidence_status"],
      "properties": {"id": {"type": "string"}, "atom_id": {"type": "string"}, "raw_id": {"type": "string"},
        "anchor": {"$ref": "#/$defs/anchor"}, "statement": {"type": "string"},
        "source_status": {"enum": ["explicit", "attributed", "editor_inference", "visual_unverified"]},
        "evidence_status": {"const": "anchor_verified"}}, "additionalProperties": false},
    "family": {"type": "object", "required": ["id", "key", "claim_ids", "status"],
      "properties": {"id": {"type": "string"}, "key": {"type": "string"}, "claim_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "status": {"enum": ["exact_group", "suggested_semantic_group"]}}, "additionalProperties": false},
    "theme": {"type": "object", "required": ["id", "name", "central_question", "inclusion", "exclusion", "family_ids", "status"],
      "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "central_question": {"type": ["string", "null"]},
        "inclusion": {"type": ["string", "null"]}, "exclusion": {"type": ["string", "null"]},
        "family_ids": {"type": "array", "items": {"type": "string"}}, "status": {"const": "suggested"}}, "additionalProperties": false},
    "relation": {"type": "object", "required": ["id", "from_claim_id", "to_claim_id", "type", "status", "rationale"],
      "properties": {"id": {"type": "string"}, "from_claim_id": {"type": "string"}, "to_claim_id": {"type": "string"},
        "type": {"enum": ["REPEATS", "REFINES", "EXTENDS", "CONTRADICTS", "RETRACTS", "ORIGIN", "APPLICATION"]},
        "status": {"const": "suggested"}, "rationale": {"type": ["string", "null"]}}, "additionalProperties": false},
    "proposal": {"type": "object", "required": ["id", "target", "text", "supporting_claim_ids", "status", "conflict_claim_ids"],
      "properties": {"id": {"type": "string"}, "target": {"type": "string"}, "text": {"type": "string"},
        "supporting_claim_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "conflict_claim_ids": {"type": "array", "items": {"type": "string"}}, "status": {"const": "pending_human_review"}}, "additionalProperties": false}
  }
}
