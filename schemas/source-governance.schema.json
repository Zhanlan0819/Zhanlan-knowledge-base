{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/kb/source-governance.schema.json",
  "title": "Source Governance Contract v0.7.0",
  "type": "object",
  "required": [
    "source_type",
    "verification_status",
    "confidence",
    "use_scope",
    "forbidden_inference"
  ],
  "additionalProperties": false,
  "properties": {
    "source_type": {
      "enum": [
        "user_experience",
        "client_case",
        "external_material",
        "network_reference",
        "ai_inference",
        "hypothesis",
        "explicit_unspecified",
        "attributed_external",
        "visual_material",
        "user_view",
        "project_practice",
        "client_material",
        "external_course",
        "external_reference",
        "mixed_source",
        "unknown_source"
      ]
    },
    "verification_status": {
      "enum": [
        "verified",
        "partially_verified",
        "pending_verification",
        "reference_only"
      ]
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "use_scope": {
      "type": "string"
    },
    "forbidden_inference": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
