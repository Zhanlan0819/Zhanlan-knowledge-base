{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/kb/artifact-envelope.schema.json",
  "type": "object",
  "required": ["artifact_id", "run_id", "stage", "version", "producer", "created_at", "inputs", "data"],
  "additionalProperties": false,
  "properties": {
    "artifact_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "stage": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "producer": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stage", "artifact_id", "sha256"],
        "additionalProperties": false,
        "properties": {
          "stage": {"type": "string"},
          "artifact_id": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["model", "runner", "attempt_id", "context_sha256"],
      "additionalProperties": false,
      "properties": {
        "instruction_path": {"type": "string", "minLength": 1},
        "instruction_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "skill_path": {"type": "string", "minLength": 1},
        "skill_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "model": {"type": "string", "minLength": 1},
        "runner": {"type": "string", "minLength": 1},
        "attempt_id": {"type": "string", "minLength": 1},
        "context_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "anyOf": [
        {"required": ["instruction_path", "instruction_sha256"]},
        {"required": ["skill_path", "skill_sha256"]}
      ]
    },
    "data": {"type": "object"}
  }
}
