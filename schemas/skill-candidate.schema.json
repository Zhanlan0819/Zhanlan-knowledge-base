{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/kb/skill-candidate.schema.json",
  "title": "Skill Candidate Contract",
  "type": "object",
  "properties": {
    "verification": {
      "type": "object",
      "required": ["source_sufficiency", "executability", "task_utility"],
      "additionalProperties": false,
      "properties": {
        "source_sufficiency": {"type": "boolean"},
        "executability": {"type": "boolean"},
        "task_utility": {"type": "boolean"}
      }
    },
    "promotion": {
      "type": "object",
      "required": ["independent_intent", "independent_contract", "independent_run", "independent_reuse", "independent_eval"],
      "additionalProperties": false,
      "properties": {
        "independent_intent": {"type": "boolean"},
        "independent_contract": {"type": "boolean"},
        "independent_run": {"type": "boolean"},
        "independent_reuse": {"type": "boolean"},
        "independent_eval": {"type": "boolean"}
      }
    },
    "ria": {
      "type": "object",
      "required": ["R", "I", "A1", "A2", "E", "B"],
      "additionalProperties": false,
      "properties": {
        "R": {"type": "string", "minLength": 1},
        "I": {"type": "string", "minLength": 1},
        "A1": {"type": "string", "minLength": 1},
        "A2": {"type": "string", "minLength": 1},
        "E": {"type": "string", "minLength": 1},
        "B": {"type": "string", "minLength": 1}
      }
    }
  }
}
